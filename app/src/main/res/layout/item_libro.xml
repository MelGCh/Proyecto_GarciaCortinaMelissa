<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemLibro"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:background="#EEEEEE">

    <TextView
        android:id="@+id/tvwTituloLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/tvwAutorLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Autor"
        android:textSize="15sp"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/tvwGeneroLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Género"
        android:textSize="14sp"
        android:textColor="#555555" />

    <TextView
        android:id="@+id/tvwEstadoLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado"
        android:textSize="14sp"
        android:textColor="#555555" />

    <TextView
        android:id="@+id/tvwCalificacionLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calificación"
        android:textSize="14sp"
        android:textColor="#555555" />

    <TextView
        android:id="@+id/tvwComentarioLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comentario"
        android:textSize="14sp"
        android:textColor="#555555" />

    <TextView
        android:id="@+id/tvwFavoritoLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Favorito"
        android:textSize="14sp"
        android:textColor="#555555" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnFavorito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Favorito" />

        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Eliminar" />

    </LinearLayout>

</LinearLayout>